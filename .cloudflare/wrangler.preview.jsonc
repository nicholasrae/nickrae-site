{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Isolated preview only. No custom domains, routes or DNS changes.
  "name": "nickrae-preview",
  "main": "./preview-worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
